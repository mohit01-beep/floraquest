# FloraQuest Environment Variables
# Copy this to .env and configure your keys

# Backboard API Key (claim from hacktoberfest.com/my/promos)
BACKBOARD_API_KEY=your_backboard_api_key_here
BACKBOARD_PROJECT_ID=floraquest-dev

# Tinker / Thinking Machines API (claim promo credit)
TINKER_API_KEY=your_tinker_api_key_here
TINKER_MODEL_ID=floraquest-qwen-tuned-v1

# App Settings
ENVIRONMENT=production
PORT=8000
DEBUG=False
